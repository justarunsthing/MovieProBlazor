@page "/popular"

@inject TmdbService tmdbService
@inject NavigationManager Navigation

<PageTitle>Popular</PageTitle>

<div class="container-xxl py-3">
    <h1>
        <i class="bi bi-stars text-warning"></i>
        Popular
    </h1>
    <p class="lead italic">
        Movies that are currently popular with TMDb users
    </p>

    @if (popularMovies == null)
    {
        <div class="d-flex justify-content-center align-items-center">
            @if (isLoading)
            {
                <h2 class="text-muted">Loading Popular Movies...</h2>
            }
            else
            {
                <h2 class="text-danger">Failed to load Popular Movies</h2>
            }
        </div>
    }
    else
    {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4">
            @foreach (var movie in popularMovies.Results)
            {
                <div class="col">
                    <MovieCard movie="movie" />
                </div>
            }
        </div>
        <MoviePager Page="popularMovies.Page" TotalPages="popularMovies.TotalPages" Label="Popular pages" PageChanged="GoToPage" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int PageQuery { get; set; }

    private MovieListResponse? popularMovies;
    private bool isLoading = true;
    private int Page => PageQuery < 1 ? 1 : PageQuery;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            isLoading = true;
            popularMovies = null;
            popularMovies = await tmdbService.GetPopularMoviesAsync(Page);
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoToPage(int page)
    {
        Navigation.NavigateTo(page <= 1 ? "/popular" : $"/popular?page={page}");
    }
}