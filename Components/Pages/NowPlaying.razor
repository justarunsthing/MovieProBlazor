@page "/now-playing"

@inject TmdbService tmdbService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Now Playing</PageTitle>

<div class="container-xxl py-3">
    <h1 @ref="pageTitle">
        <i class="bi bi-film text-primary"></i>
        Now Playing
    </h1>
    <p class="lead italic">
        Movies that are currently playing in theaters
    </p>

    @if (nowPlayingMovies == null)
    {
        <div class="d-flex justify-content-center align-items-center">
            @if (isLoading)
            {
                <h2 class="text-muted">Loading Now Playing Movies...</h2>
            }
            else
            {
                <h2 class="text-danger">Failed to load Now Playing Movies</h2>
            }
        </div>
    }
    else
    {
        <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 @(isLoading ? "opacity-50 pe-none" : null)" aria-busy="@isLoading">
            @foreach (var movie in nowPlayingMovies.Results)
            {
                <div class="col">
                    <MovieCard movie="movie" />
                </div>
            }
        </div>
        <MoviePager Page="nowPlayingMovies.Page" TotalPages="nowPlayingMovies.TotalPages" Label="Now playing pages" PageChanged="GoToPage" Disabled="isLoading" />
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "page")]
    public int PageQuery { get; set; }

    private MovieListResponse? nowPlayingMovies;
    private bool isLoading = true;
    private int requestId;
    private bool scrollToTitle;
    private ElementReference pageTitle;
    private int Page => PageQuery < 1 ? 1 : PageQuery;

    protected override async Task OnParametersSetAsync()
    {
        var request = ++requestId;
        var previousPage = nowPlayingMovies?.Page;

        try
        {
            isLoading = true;
            var response = await tmdbService.GetNowPlayingMoviesAsync(Page);

            if (request != requestId)
            {
                return;
            }

            nowPlayingMovies = response;
            scrollToTitle = previousPage is not null && previousPage != response.Page;
        }
        catch (Exception ex)
        {
            if (request != requestId)
            {
                return;
            }

            Console.WriteLine(ex.Message);
            nowPlayingMovies = null;
            scrollToTitle = false;
        }
        finally
        {
            if (request == requestId)
            {
                isLoading = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToTitle)
        {
            return;
        }

        scrollToTitle = false;
        await JS.InvokeVoidAsync("scrollToElement", pageTitle);
    }

    private void GoToPage(int page)
    {
        Navigation.NavigateTo(page <= 1 ? "/now-playing" : $"/now-playing?page={page}");
    }
}