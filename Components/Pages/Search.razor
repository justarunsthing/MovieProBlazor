@page "/search"

@inject TmdbService tmdbService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Search</PageTitle>

<div class="container-xxl py-3">
    <h1 @ref="pageTitle">
        <i class="bi bi-search text-warning"></i>
        Search Movies
    </h1>
    <p class="lead italic">
        Movies matching your search
    </p>

    @if (searchResults == null)
    {
        <div class="d-flex justify-content-center align-items-center">
            @if (string.IsNullOrEmpty(Query))
            {
                <h2 class="text-muted">
                    Please enter a search query at the top of the page
                </h2>
            }
            else if (isLoading)
            {
                <h2 class="text-muted">
                    Loading search results...
                </h2>
            }
            else
            {
                <h2 class="text-danger">Failed to load search results</h2>
            }
        </div>
    }
    else
    {
        @if (searchResults.TotalResults == 0)
        {
            <div class="d-flex justify-content-center align-items-center py-5">
                <h2 class="text-muted">
                    No movies found for "@Query"
                </h2>
            </div>
        }
        else
        {
            <div class="row g-3 row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 @(isLoading ? "opacity-50 pe-none" : null)" aria-busy="@isLoading">
                @foreach (var movie in searchResults.Results)
                {
                    <div class="col">
                        <MovieCard movie="movie" />
                    </div>
                }
            </div>
            <MoviePager Page="searchResults.Page" TotalPages="searchResults.TotalPages" Label="Search pages" PageChanged="GoToPage" Disabled="isLoading" />
        }
    }
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Query { get; set; }

    [SupplyParameterFromQuery(Name = "page")]
    public int PageQuery { get; set; }

    private MovieListResponse? searchResults;
    private bool isLoading = true;
    private int requestId;
    private bool scrollToTitle;
    private string? loadedQuery;
    private ElementReference pageTitle;
    private int Page => PageQuery < 1 ? 1 : PageQuery;

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrEmpty(Query))
        {
            requestId++;
            searchResults = null;
            loadedQuery = null;
            isLoading = false;
            scrollToTitle = false;
            return;
        }

        var request = ++requestId;
        var previousPage = searchResults?.Page;
        var sameQuery = string.Equals(loadedQuery, Query, StringComparison.Ordinal);

        if (!sameQuery)
        {
            searchResults = null;
        }

        try
        {
            isLoading = true;
            var response = await tmdbService.GetSearchResultsAsync(Query, Page);

            if (request != requestId)
            {
                return;
            }

            searchResults = response;
            loadedQuery = Query;
            scrollToTitle = sameQuery && previousPage is not null && previousPage != response.Page;
        }
        catch (Exception ex)
        {
            if (request != requestId)
            {
                return;
            }

            Console.WriteLine(ex.Message);
            searchResults = null;
            loadedQuery = null;
            scrollToTitle = false;
        }
        finally
        {
            if (request == requestId)
            {
                isLoading = false;
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!scrollToTitle)
        {
            return;
        }

        scrollToTitle = false;
        await JS.InvokeVoidAsync("scrollToElement", pageTitle);
    }

    private void GoToPage(int page)
    {
        var query = Uri.EscapeDataString(Query ?? string.Empty);
        Navigation.NavigateTo(page <= 1
            ? $"/search?query={query}"
            : $"/search?query={query}&page={page}");
    }
}